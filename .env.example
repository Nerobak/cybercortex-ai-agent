# ======================================================
# CyberCortex AI Agent Configuration Example
# ======================================================

# Legacy OpenAI-compatible Ollama endpoint. This loopback example is device-local;
# a non-loopback URL sends model input over the configured network path.
OPENAI_BASE_URL=http://localhost:11434/v1

# Cloud provider keys must come from the environment. Keep placeholders blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Legacy Ollama model
OPENAI_MODEL=deepseek-r1:32b

# Phase 3 provider foundation (no automatic routing in P3-1)
# MODEL_DEFAULT_PROVIDER selects a provider family, not endpoint locality.
MODEL_DEFAULT_PROVIDER=ollama
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4096
P3_OPENAI_MODEL=
P3_OPENAI_BASE_URL=
P3_ANTHROPIC_MODEL=
P3_ANTHROPIC_BASE_URL=
# Loopback is device-local. Verify this value before relying on device-local privacy;
# a non-loopback Ollama URL can transmit sanitized model evidence over a network.
OLLAMA_BASE_URL=http://127.0.0.1:11434
P3_OLLAMA_MODEL=deepseek-r1:32b

# ------------------------------------------------------
# Authorized Targets
#
# Add ONLY domains you own or are explicitly authorized
# to assess.
# ------------------------------------------------------

PENTEST_ALLOWLIST=example.com,localhost,127.0.0.1

# ------------------------------------------------------
# Active Scanning
#
# false = Recon only (recommended)
# true  = Allow active scanning (Nuclei, etc.)
# ------------------------------------------------------

ENABLE_ACTIVE_SCANNING=true
# Required in addition to ENABLE_ACTIVE_SCANNING for --profile intrusive.
# Enable only when the written rules of engagement permit payload-bearing tests.
ENABLE_INTRUSIVE_SCANNING=false
# Minimum included Nuclei severity: info, low, medium, high, or critical.
# "low" also includes medium, high, and critical findings.
NUCLEI_SEVERITY=low
NUCLEI_RATE_LIMIT=3
NUCLEI_TIMEOUT_SECONDS=120
# OAST sends interaction data to an external callback service; keep disabled
# unless the assessment rules explicitly permit it.
NUCLEI_ENABLE_OAST=false
AGENT_REQUEST_BUDGET=100
# Phase 2 adaptive-loop ceilings. The smallest applicable policy/runtime limit wins.
ADAPTIVE_MAX_HYPOTHESES=20
ADAPTIVE_MAX_VERIFICATIONS=10
ADAPTIVE_MAX_REQUESTS=50
ADAPTIVE_MAX_RUNTIME_SECONDS=600
# Execute registered network tools in killable subprocesses.
AGENT_ISOLATE_NETWORK_TOOLS=true
# Bounded, read-only API metadata discovery after an evidence-driven pivot.
API_METADATA_DISCOVERY_ENABLED=true
API_METADATA_MAX_REQUESTS=8
API_METADATA_TIMEOUT_SECONDS=10
API_METADATA_MAX_RESPONSE_BYTES=2000000
# GraphQL introspection is opt-in and remains an observation when available.
GRAPHQL_INTROSPECTION_ENABLED=false
GRAPHQL_TIMEOUT_SECONDS=15
GRAPHQL_MAX_RESPONSE_BYTES=1000000
