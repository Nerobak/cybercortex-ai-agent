# ======================================================
# CyberCortex AI Agent Configuration Example
# ======================================================

# Ollama API Endpoint
OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama does not require a real API key.
OPENAI_API_KEY=ollama

# Local model
OPENAI_MODEL=deepseek-r1:32b

# ------------------------------------------------------
# Authorized Targets
#
# Add ONLY domains you own or are explicitly authorized
# to assess.
# ------------------------------------------------------

PENTEST_ALLOWLIST=example.com,localhost,127.0.0.1

# ------------------------------------------------------
# Active Scanning
#
# false = Recon only (recommended)
# true  = Allow active scanning (Nuclei, etc.)
# ------------------------------------------------------

ENABLE_ACTIVE_SCANNING=true
